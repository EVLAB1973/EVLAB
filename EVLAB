    const p = document.getElementById('leadPhone').value;
    if(!n || !p) { alert("נא למלא שם וטלפון"); return; }
    window.location.href = `https://wa.me/972502232222?text=${encodeURIComponent("היי, שמי "+n+" טלפון "+p+", אשמח שתחזרו אליי.")}`;
}

let slides = document.querySelectorAll(".bg-slide");
let cur = 0;
setInterval(() => {
    slides[cur].classList.remove("active");
    cur = (cur + 1) % slides.length;
    slides[cur].classList.add("active");
}, 5000);

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if(entry.isIntersecting) {
            if(entry.target.id === 'servicesGrid') document.getElementById('servicesGrid').classList.add('start-domino-9');
            if(entry.target.id === 'whyGrid') document.getElementById('whyGrid').classList.add('start-domino-6');
        }
    });
}, { threshold: 0.5 });

observer.observe(document.getElementById('servicesGrid'));
observer.observe(document.getElementById('whyGrid'));

let isAutoScrolling = true;
function autoScroll() {
    if(!isAutoScrolling) return;
    window.scrollBy(0, 1.1);
    if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 5) { window.scrollTo(0, 0); }
}
function pauseScroll() {
    isAutoScrolling = false;
    document.querySelectorAll('.unified-card, .why-card').forEach(c => c.classList.add('reading-mode'));
    setTimeout(() => {
        isAutoScrolling = true;
        document.querySelectorAll('.unified-card, .why-card').forEach(c => c.classList.remove('reading-mode'));
    }, 5000);
}
window.addEventListener('touchstart', pauseScroll, {passive: true});
window.addEventListener('mousedown', pauseScroll);
setInterval(autoScroll, 30);
</script>

