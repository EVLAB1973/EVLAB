<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>EV LAB | Tesla Experts</title>

<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --neon-blue: #00f0ff;
    --neon-white: #ffffff;
    --dark-bg: #0b1118;
    --soft-border: rgba(255, 255, 255, 0.2); 
    --card-bg: rgba(255, 255, 255, 0.08);
}

*{margin:0;padding:0;box-sizing:border-box;font-family:'Assistant',sans-serif;}
body{background: var(--dark-bg); color: #fff; overflow-x:hidden; width: 100%;}

/* אנימציות */
@keyframes hyper-dance {
    0% { transform: translate(0, 0) rotate(0deg) scale(1); }
    25% { transform: translate(12px, -15px) rotate(8deg) scale(1.08); }
    50% { transform: translate(-8px, 0px) rotate(-6deg) scale(1.1); }
    75% { transform: translate(10px, -10px) rotate(4deg) scale(1.05); }
    100% { transform: translate(0, 0) rotate(0deg) scale(1); }
}

@keyframes camera-shake {
    0% { transform: rotate(0deg); }
    25% { transform: rotate(10deg) scale(1.1); }
    50% { transform: rotate(-10deg) scale(1.1); }
    75% { transform: rotate(10deg) scale(1.1); }
    100% { transform: rotate(0deg); }
}

@keyframes domino-glow {
    0%, 20% { background: var(--card-bg); box-shadow: none; border-color: var(--soft-border); transform: translateY(0); }
    10% { background: rgba(0, 240, 255, 0.15); box-shadow: 0 0 25px rgba(0, 240, 255, 0.6); border-color: var(--neon-blue); transform: translateY(-10px); }
    100% { background: var(--card-bg); box-shadow: none; border-color: var(--soft-border); transform: translateY(0); }
}

/* רקע */
.bg-slider{ position:fixed; top:0; left:0; width:100%; height:100%; z-index:-2; }
.bg-slide{ position:absolute; width:100%; height:100%; background-size:cover; background-position:center; opacity:0; transition:opacity 2s ease; filter: brightness(0.6) contrast(1.1); }
.bg-slide.active{opacity:1;}
.overlay{ position:fixed; top:0; left:0; width:100%; height:100%; background:radial-gradient(circle, transparent 20%, var(--dark-bg) 95%); z-index:-1; }

/* לוגו מרכזי חדש */
header { 
    position: absolute; 
    top: 40px; 
    right: 0; 
    left: 0; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    justify-content: center;
    z-index: 10; 
    text-align: center;
}
header h1 { 
    font-size: 82px; 
    font-weight: 900; 
    line-height: 0.85; 
    margin: 0;
    display: flex;
    gap: 15px;
}
.ev-glow { color: var(--neon-white); text-shadow: 0 0 25px rgba(255, 255, 255, 0.6); }
.lab-glow { color: transparent; -webkit-text-stroke: 1.5px var(--neon-blue); text-shadow: 0 0 10px rgba(0, 240, 255, 0.3); }

.logo-tagline-en { 
    font-size: 16px; 
    color: rgba(0, 240, 255, 0.8); 
    font-weight: 400; 
    margin-top: 12px; 
    letter-spacing: 2px; 
    text-transform: uppercase;
    width: 100%;
}

/* כפתורי צד */
.side-controls { position: fixed; top: 20px; left: 15px; display: flex; flex-direction: column; gap: 20px; z-index: 9999; }
.float-btn { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(0, 240, 255, 0.05); border: 2px solid var(--neon-blue); backdrop-filter: blur(12px); animation: hyper-dance 3s infinite ease-in-out; text-decoration: none; cursor: pointer; }
.float-btn.sos { color: var(--neon-blue); font-weight: 900; font-size: 15px; text-align: center; line-height: 1.1; }
.float-btn svg { fill: var(--neon-blue); width: 31px; height: 31px; }

/* Hero */
.hero { min-height: 80vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; text-align: right; padding: 220px 0 40px; width: 78%; margin-right: auto; margin-left: 110px; }
.hero h2 { font-size: 48px; font-weight: 900; color: #fff; text-shadow: 0 0 15px rgba(255, 255, 255, 0.8); }
.hero p.tagline { font-size: 24px; color: var(--neon-blue); font-weight: 700; margin-bottom: 30px; }
.hero-bullets { background: rgba(255,255,255,0.03); padding: 25px; border-radius: 25px; border: 1px solid rgba(255,255,255,0.1); font-size: 18px; line-height: 1.8; width: 100%; max-width: 450px; backdrop-filter: blur(5px); }

/* גריד שירותים */
.section-title { font-size: 38px; text-align: right; margin: 60px 0 30px; color: #fff; font-weight: 800; width: 78%; margin-right: auto; margin-left: 110px; }
.unified-grid, .why-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; width: 78%; margin-right: auto; margin-left: 110px; }

.unified-card, .why-card { 
    background: var(--card-bg); 
    border: 1px solid var(--soft-border); 
    border-radius: 15px; 
    padding: 25px 20px; 
    text-align: right; 
    backdrop-filter: blur(5px); 
    transition: all 0.4s ease; 
}

/* דומינו */
.start-domino-9 .unified-card { animation: domino-glow 9s infinite; }
.start-domino-6 .why-card { animation: domino-glow 6s infinite; }
.unified-card:nth-child(1) { animation-delay: 0s; }
.unified-card:nth-child(2) { animation-delay: 1s; }
.unified-card:nth-child(3) { animation-delay: 2s; }
.unified-card:nth-child(4) { animation-delay: 3s; }
.unified-card:nth-child(5) { animation-delay: 4s; }
.unified-card:nth-child(6) { animation-delay: 5s; }
.unified-card:nth-child(7) { animation-delay: 6s; }
.unified-card:nth-child(8) { animation-delay: 7s; }
.unified-card:nth-child(9) { animation-delay: 8s; }

.unified-card h3, .why-card h4 { color: var(--neon-blue); font-size: 22px; margin-bottom: 12px; font-weight: 800; display: flex; align-items: center; gap: 12px; }
.why-card { text-align: center; }
.why-card h4 { justify-content: center; }
.why-card .icon { font-size: 35px; margin-bottom: 15px; display: block; }

.inline-camera-icon { width: 32px; height: 32px; fill: #FFD700; animation: camera-shake 1.5s infinite ease-in-out; }

/* מצב קריאה */
.reading-mode { background: rgba(0, 0, 0, 0.4) !important; border-color: var(--neon-blue) !important; box-shadow: 0 0 15px rgba(0, 240, 255, 0.3) !important; }

/* טופס */
.lead-form { width: 78%; margin-right: auto; margin-left: 110px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 35px; border-radius: 20px; margin-top: 50px; }
.lead-form input { width: 100%; padding: 18px; margin-bottom: 15px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.4); color: #fff; text-align: right; font-size: 16px; }
.lead-form button { width: 100%; padding: 20px; border-radius: 12px; background: var(--neon-blue); color: #000; font-weight: 900; border: none; font-size: 22px; cursor: pointer; transition: 0.3s; }

/* חברתי */
.social-row { display: flex; justify-content: center; gap: 15px; padding: 60px 0; flex-wrap: wrap; width: 78%; margin-right: auto; margin-left: 110px; }
.dance-box { 
    width: 75px; height: 75px; border-radius: 50%; display: flex; align-items: center; justify-content: center; 
    border: 2px solid var(--neon-blue); background: rgba(0, 240, 255, 0.05); 
    backdrop-filter: blur(10px); animation: hyper-dance 3.5s infinite ease-in-out;
    text-decoration: none; cursor: pointer;
}
.dance-box svg { width: 38px; height: 38px; }
.icon-facebook svg { fill: #1877F2; }
.icon-whatsapp svg { fill: #25D366; }
.icon-instagram svg { fill: #E1306C; }
.icon-camera svg { fill: #FFD700; }
.icon-sos { color: #FF0000; font-weight: 900; font-size: 19px; border-color: #FF0000; }
.icon-phone svg { fill: #00f0ff; }

footer { text-align: center; padding: 50px; color: #888; font-size: 15px; border-top: 1px solid rgba(255,255,255,0.05); }

#fileInput { display: none; }

@media (max-width: 600px) { 
    .hero, .section-title, .unified-grid, .why-grid, .lead-form, .social-row { width: 90%; margin: 0 auto 30px; }
    header { top: 30px; }
    header h1 { font-size: 50px; }
    .logo-tagline-en { font-size: 11px; letter-spacing: 1px; }
    .unified-grid, .why-grid { grid-template-columns: 1fr; }
    .side-controls { left: 8px; }
}
</style>
</head>
